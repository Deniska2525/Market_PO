# Скопируйте этот файл в .env: cp .env.example .env
# .env НЕ должен попадать в git (см. .gitignore).
# Для локального запуска через docker compose достаточно подставить SECRET_KEY и пароли.

# Строка подключения к БД. Хост «db» — имя сервиса в docker-compose, логин, пароль и база
# заданы там же. ?sslmode=disable обязателен локально: иначе backend сам допишет
# ?sslmode=require, а локальный Postgres поднят без SSL и не примет соединение.
DATABASE_URL=postgresql://postgres:postgres@db:5432/marketplace?sslmode=disable

# Секрет для подписи JWT-токенов. Сгенерировать:
#   docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Адрес сайта для CORS (docker-compose раздаёт фронтенд nginx на порту 80)
FRONTEND_URL=http://localhost

# Адрес API для сборки фронтенда. Локально оставьте пустым (будет http://localhost:8000);
# для сервера укажите публичный адрес бэкенда, например https://api.example.edu
#VITE_API_BASE_URL=

# development | production. В production: Secure-cookie (нужен HTTPS), обязательный
# SECRET_KEY, демо-данные не создаются.
ENV=development

# Пароли демо-аккаунтов (создаются при первом запуске на пустой базе).
# Если не заданы, берутся пароли по умолчанию из кода — они публичные, поэтому задайте свои.
#   superuser, admin_cyber, admin_bio -> SEED_ADMIN_PASSWORD;  anna -> SEED_USER_PASSWORD
# Пароль: не короче 8 символов, с буквами и цифрами.
#SEED_ADMIN_PASSWORD=
#SEED_USER_PASSWORD=
# В production демо-данные создаются только при SEED_DEMO_USERS=true
#SEED_DEMO_USERS=false

# Первый суперадмин для production (создаётся, если суперадмина ещё нет)
#SUPERUSER_USERNAME=
#SUPERUSER_EMAIL=
#SUPERUSER_PASSWORD=

# Ключ нейросети для подбора разработок на главной странице. Работает с любым
# OpenAI-совместимым провайдером; бесплатные варианты без карты:
#   OpenRouter (по умолчанию, Gemma 4): https://openrouter.ai/keys
#   Groq:                               https://console.groq.com/keys
#   Gemini:                             https://aistudio.google.com/apikey
# ОСТАВЬТЕ ПУСТЫМ, если ключа нет: тогда поиск работает в запасном режиме по ключевым
# словам и связанным темам (без нейросети), остальной сайт не затронут.
AI_API_KEY=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
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemma-4-31b-it:free

# --- Загрузка изображений (необязательно) ---
# Максимальный размер изображения в МБ (по умолчанию 5)
#MAX_IMAGE_MB=5

# --- Хостинг без диска (Render и подобные), см. docs/RENDER.md ---
# Где хранить изображения: disk (по умолчанию, файлы на диске) или db (в базе данных)
#MEDIA_STORAGE=disk
# Путь cookie сессии. За прокси с префиксом /api нужен /api/users; локально не задавайте
#REFRESH_COOKIE_PATH=/users

